dist/
build/

# ─── Skill runtime cache ─────
.skill-data/
.cache/
tmp/
output/

# ─── AI agent internal ─────
sign.key
.install-source.json
skill_meta.json
*.json.md

# ─── Local personal profiles (never commit) ─────
