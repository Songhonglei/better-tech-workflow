id_ed25519.*
*.pem
*.p12
*.pfx
*.keystore
**/certs/*.key
**/secrets/
.env
.env.*
!.env.example
*.token
*token*.json
.secrets/

# ─── OS / Editor ─────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

